# Copy to .env (git-ignored). Without keys the app runs in replay mode and costs nothing.
meta_api=            # Meta Model API: Muse Spark 1.3 and Muse Voice Transcribe
baseten_api_key=     # Baseten: Muse Spark Open
ANUBHAV_PUBLIC=      # 1 on a public host: each visitor gets their own drafts and lessons
ANUBHAV_HOME=        # optional: the folder holding configs/ and data/, if the package is installed elsewhere
