{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prashanth-ds-ml/anubhav/contracts/events.schema.json",
  "title": "Anubhav event",
  "description": "One event of a request's stream (design v1 §4.5, D-044). Produced by src/anubhav/events.py from a saved run (live or replay, single Planner or team). The live stream and the history read the same events. Contract version 1.0.0: a change here needs both the Python and the web tests to pass.",
  "type": "object",
  "required": ["run_id", "seq", "agent_id", "agent_run_id", "caller", "depth", "ts", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string", "description": "The request's id (the lead agent's run)."},
    "seq": {"type": "integer", "minimum": 0, "description": "Order within the request, from 0, no gaps. A reconnecting stream asks for seq > last seen."},
    "agent_id": {"type": "string", "description": "Which agent acted (an id from configs/agents.yaml)."},
    "agent_run_id": {"type": "string", "description": "That agent's own run id (equals run_id for the lead)."},
    "caller": {"type": "string", "description": "Who asked this agent: 'person' for the lead, otherwise the delegating agent's id."},
    "depth": {"type": "integer", "minimum": 0, "maximum": 2, "description": "0 = lead; 1-2 = teammates reached by delegate."},
    "ts": {"type": ["string", "null"], "description": "When the run was saved (ISO 8601); null for a run not yet saved."},
    "type": {"enum": ["agent_start", "tool_call", "tool_result", "retry", "tool_missing", "handoff", "lesson_used",
                      "validator_check", "draft_created", "agent_done", "learning_event", "needs_person"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "agent_start"}}},
     "then": {"properties": {"payload": {"required": ["request", "model", "lessons_in_prompt"]}}}},
    {"if": {"properties": {"type": {"const": "tool_call"}}},
     "then": {"properties": {"payload": {"required": ["tool", "arguments"]}}}},
    {"if": {"properties": {"type": {"const": "tool_result"}}},
     "then": {"properties": {"payload": {"required": ["tool", "ok"]}}}},
    {"if": {"properties": {"type": {"const": "retry"}}},
     "then": {"properties": {"payload": {"required": ["tool", "attempt", "of"]}}}},
    {"if": {"properties": {"type": {"const": "tool_missing"}}},
     "then": {"properties": {"payload": {"required": ["need", "next_step"]}}}},
    {"if": {"properties": {"type": {"const": "handoff"}}},
     "then": {"properties": {"payload": {"required": ["from", "to", "brief"]}}}},
    {"if": {"properties": {"type": {"const": "lesson_used"}}},
     "then": {"properties": {"payload": {"required": ["tool", "lessons"]}}}},
    {"if": {"properties": {"type": {"const": "validator_check"}}},
     "then": {"properties": {"payload": {"required": ["tool", "pass"]}}}},
    {"if": {"properties": {"type": {"const": "draft_created"}}},
     "then": {"properties": {"payload": {"required": ["draft_id", "vehicle_id", "orders"]}}}},
    {"if": {"properties": {"type": {"const": "agent_done"}}},
     "then": {"properties": {"payload": {"required": ["reply", "stop", "cost_usd", "tool_calls", "drafts"]}}}},
    {"if": {"properties": {"type": {"const": "learning_event"}}},
     "then": {"properties": {"payload": {"required": ["kind", "agent", "decision"]}}}},
    {"if": {"properties": {"type": {"const": "needs_person"}}},
     "then": {"properties": {"payload": {"required": ["rule", "question", "agent", "drafts", "tools_used"]}}}}
  ]
}
